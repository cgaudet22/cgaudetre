# Core runtime
SLEEPY_OUTPUT_DIR=outputs
SLEEPY_SHORT_RUN=0
SLEEPY_SEGMENT_COUNT=6

# Google credentials (Sheets + YouTube)
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service_account.json
SLEEPY_SHEET_NAME=SleepyQueue
SLEEPY_WORKSHEET_NAME=Queue

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-chat

# Pollinations
POLLINATIONS_SIZE=1280x720

# Inworld TTS
INWORLD_API_KEY=
INWORLD_VOICE_ID=
INWORLD_TTS_URL=https://api.inworld.ai/tts

# YouTube
YOUTUBE_PRIVACY_STATUS=private
